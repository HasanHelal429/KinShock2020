# ==========================================================================
# KinShock2020 / R0 -- SMOKE TEST of the R1 setup on a tiny/fast grid.
# Identical physics primaries to runs/R1/inputs_kinshock_R1; only the grid,
# step count, and ppc are shrunk. Purpose: verify the deck loads, the heater
# and target injector are active, there are no NaNs, dt*wpe is as derived, and
# the analysis pipeline runs end-to-end. NOT a physics run (t ~ 0.075 wci0^-1).
# Mirrors runs/R0/config.yaml.
# ==========================================================================

my_constants.n0           = 1.e18
my_constants.mass_ratio   = 100.
my_constants.Mi           = mass_ratio*m_e
my_constants.wpe          = sqrt(n0*q_e^2/(epsilon0*m_e))
my_constants.de           = clight/wpe
my_constants.di           = de*sqrt(mass_ratio)
my_constants.nt           = 2.5*n0
my_constants.namb         = 0.01*n0
my_constants.vA           = 0.01*clight
my_constants.B0           = vA*sqrt(mu0*namb*Mi)
my_constants.theta_e_heat = 0.092
my_constants.theta0       = 0.002
my_constants.theta_e_init = 0.001
my_constants.theta_i_init = 1.e-5
my_constants.slab         = 20.*de
my_constants.half         = 500.*de      # smoke domain half-width

max_step      = 2000                      # smoke
warpx.cfl     = 0.75
warpx.verbose = 1

amr.n_cell        = 2000                   # smoke (dz = 0.5 d_e)
amr.max_level     = 0
geometry.dims     = 1
geometry.prob_lo  = -half
geometry.prob_hi  =  half

boundary.field_lo    = periodic
boundary.field_hi    = periodic
boundary.particle_lo = periodic
boundary.particle_hi = periodic

algo.particle_shape = 2

warpx.B_ext_grid_init_style       = parse_B_ext_grid_function
warpx.Bx_external_grid_function(x,y,z) = "B0"
warpx.By_external_grid_function(x,y,z) = "0."
warpx.Bz_external_grid_function(x,y,z) = "0."

particles.species_names = piston_electrons piston_ions amb_electrons amb_ions

piston_electrons.species_type = electron
piston_electrons.injection_style = "NUniformPerCell"
piston_electrons.num_particles_per_cell_each_dim = 50
piston_electrons.profile = parse_density_function
piston_electrons.density_function(x,y,z) = "nt*(abs(z)<slab)"
piston_electrons.density_min = 1.
piston_electrons.momentum_distribution_type = maxwellian
piston_electrons.maxwellian_u_std_distribution_type = "constant"
piston_electrons.ux_std = sqrt(theta_e_init)
piston_electrons.uy_std = sqrt(theta_e_init)
piston_electrons.uz_std = sqrt(theta_e_init)

piston_ions.charge = q_e
piston_ions.mass   = Mi
piston_ions.injection_style = "NUniformPerCell"
piston_ions.num_particles_per_cell_each_dim = 50
piston_ions.profile = parse_density_function
piston_ions.density_function(x,y,z) = "nt*(abs(z)<slab)"
piston_ions.density_min = 1.
piston_ions.momentum_distribution_type = maxwellian
piston_ions.maxwellian_u_std_distribution_type = "constant"
piston_ions.ux_std = sqrt(theta_i_init)
piston_ions.uy_std = sqrt(theta_i_init)
piston_ions.uz_std = sqrt(theta_i_init)

amb_electrons.species_type = electron
amb_electrons.injection_style = "NUniformPerCell"
amb_electrons.num_particles_per_cell_each_dim = 50
amb_electrons.profile = parse_density_function
amb_electrons.density_function(x,y,z) = "namb*(abs(z)>=slab)"
amb_electrons.density_min = 1.
amb_electrons.momentum_distribution_type = maxwellian
amb_electrons.maxwellian_u_std_distribution_type = "constant"
amb_electrons.ux_std = sqrt(theta0)
amb_electrons.uy_std = sqrt(theta0)
amb_electrons.uz_std = sqrt(theta0)

amb_ions.charge = q_e
amb_ions.mass   = Mi
amb_ions.injection_style = "NUniformPerCell"
amb_ions.num_particles_per_cell_each_dim = 50
amb_ions.profile = parse_density_function
amb_ions.density_function(x,y,z) = "namb*(abs(z)>=slab)"
amb_ions.density_min = 1.
amb_ions.momentum_distribution_type = maxwellian
amb_ions.maxwellian_u_std_distribution_type = "constant"
amb_ions.ux_std = sqrt(theta0/mass_ratio)
amb_ions.uy_std = sqrt(theta0/mass_ratio)
amb_ions.uz_std = sqrt(theta0/mass_ratio)

particle_heater.species   = piston_electrons
particle_heater.intervals = 20
particle_heater.profile   = foil
particle_heater.foil.normal      = z
particle_heater.foil.lo          = -slab
particle_heater.foil.hi          =  slab
particle_heater.foil.spot_radius = 0.
particle_heater.foil.n0          = n0
particle_heater.foil.mass_ratio  = mass_ratio
particle_heater.piston_electrons.theta = theta_e_heat

target_injector.species              = piston_electrons
target_injector.neutralizing_species = piston_ions
target_injector.intervals            = 20
target_injector.tau                  = 40./wpe
target_injector.lo                   = -slab
target_injector.hi                   =  slab
target_injector.density              = nt
target_injector.reference_density    = n0
target_injector.ppc_reference        = 50
target_injector.piston_electrons.u_std = sqrt(theta_e_init)
target_injector.piston_ions.u_std      = sqrt(theta_i_init)

warpx.reduced_diags_names = EP PN
EP.type      = ParticleEnergy
EP.intervals = 50
PN.type      = ParticleNumber
PN.intervals = 50

diagnostics.diags_names = diag1
diag1.intervals = 200
diag1.diag_type = Full
