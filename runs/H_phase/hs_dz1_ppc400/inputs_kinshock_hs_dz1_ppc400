# --- primaries (mirror config.yaml) ---
my_constants.n0           = 6e26
my_constants.mass_ratio   = 100.
my_constants.Mi           = mass_ratio*m_e
my_constants.wpe          = sqrt(n0*q_e^2/(epsilon0*m_e))
my_constants.de           = clight/wpe
my_constants.di           = de*sqrt(mass_ratio)
my_constants.nt           = 2.*n0
my_constants.namb         = 0.008*n0
my_constants.B0           = 7.026446809478
my_constants.theta_e_heat = 0.000919767056
my_constants.theta0       = 1.95695118e-05
my_constants.theta_e_init = 1.95695118e-05
my_constants.theta_i_init = 1.95695118e-07
my_constants.slab         = 0.*di
my_constants.half         = 115.2*de

# --- time / solver ---
max_step      = 440000
warpx.cfl     = 0.75
warpx.verbose = 1

# --- grid (dz = 0.3 d_e; z = ablation / propagation axis) ---
amr.n_cell        = 768
amr.max_level     = 0
amr.max_grid_size = 768
geometry.dims     = 1
geometry.prob_lo  = -half
geometry.prob_hi  =  half

boundary.field_lo    = periodic
boundary.field_hi    = periodic
boundary.particle_lo = periodic
boundary.particle_hi = periodic

algo.particle_shape = 2

# --- background field (perpendicular: B0 along x, out of the z propagation axis) ---
warpx.B_ext_grid_init_style       = parse_B_ext_grid_function
warpx.Bx_external_grid_function(x,y,z) = "B0"
warpx.By_external_grid_function(x,y,z) = "0."
warpx.Bz_external_grid_function(x,y,z) = "0."

particles.species_names = amb_electrons amb_ions

# --- ambient electrons ---
amb_electrons.species_type = electron
amb_electrons.injection_style = "NUniformPerCell"
amb_electrons.num_particles_per_cell_each_dim = 400
amb_electrons.profile = parse_density_function
amb_electrons.density_function(x,y,z) = "namb*(abs(z)>=slab)"
amb_electrons.density_min = 1.
amb_electrons.momentum_distribution_type = maxwellian
amb_electrons.maxwellian_u_std_distribution_type = "constant"
amb_electrons.ux_std = sqrt(theta0)
amb_electrons.uy_std = sqrt(theta0)
amb_electrons.uz_std = sqrt(theta0)

# --- ambient ions ---
amb_ions.charge = q_e
amb_ions.mass   = Mi
amb_ions.injection_style = "NUniformPerCell"
amb_ions.num_particles_per_cell_each_dim = 400
amb_ions.profile = parse_density_function
amb_ions.density_function(x,y,z) = "namb*(abs(z)>=slab)"
amb_ions.density_min = 1.
amb_ions.momentum_distribution_type = maxwellian
amb_ions.maxwellian_u_std_distribution_type = "constant"
amb_ions.ux_std = sqrt(theta0/mass_ratio)
amb_ions.uy_std = sqrt(theta0/mass_ratio)
amb_ions.uz_std = sqrt(theta0/mass_ratio)

# --- Coulomb collisions (pairwise relativistic binary, Perez 2012 -- the
#     WarpX equivalent of the paper's Takizuka-Abe operator) ---
# target: lambda_ab = 20.0
#   T_e,ab = 470 eV, n_e,ab = 6e+20 cm^-3
#   -> nu_ei,ab = 2.095e+12 1/s  (nu_ei*dt = 0.000341)
#   -> mfp_ei,ab = 20 d_e,ab = 0.1789 d_i0,  lambda_ab = wce/nu_ei = 20
#   physical (NRL) lnLambda here would be 6.231
my_constants.coulomb_log = 12.228653316282426
collisions.collision_names = col_ae_ae col_ae_ai col_ai_ai
col_ae_ae.type       = pairwisecoulomb
col_ae_ae.species    = amb_electrons amb_electrons
col_ae_ae.CoulombLog = coulomb_log
col_ae_ae.ndt_supercycle = 10
col_ae_ai.type       = pairwisecoulomb
col_ae_ai.species    = amb_electrons amb_ions
col_ae_ai.CoulombLog = coulomb_log
col_ae_ai.ndt_supercycle = 10
col_ai_ai.type       = pairwisecoulomb
col_ai_ai.species    = amb_ions amb_ions
col_ai_ai.CoulombLog = coulomb_log
col_ai_ai.ndt_supercycle = 10

# --- diagnostics ---
# Reduced diags: operator sanity (energy balance, piston replenishment).
warpx.reduced_diags_names = EP PN
EP.type      = ParticleEnergy
EP.intervals = 440
PN.type      = ParticleNumber
PN.intervals = 440

# diag1: fields + raw particles for (z,uz) phase space (~20 frames).
diagnostics.diags_names = diag1 diag_fields
diag1.intervals = 22000
diag1.diag_type = Full

# diag_fields: field-only, high cadence (~200 frames) for streaks / field
# structure. No particles (write_species = 0); full grid resolution.
diag_fields.intervals     = 2200
diag_fields.diag_type     = Full
diag_fields.write_species = 0
diag_fields.fields_to_plot = Ex Ey Ez Bx By Bz jx jy jz rho rho_amb_electrons rho_amb_ions
