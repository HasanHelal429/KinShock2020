#
# ONE calibration point for the electron-fluid heater amplitude, at
# theta_e_equiv = 1.993066e-4 -- the geometric mean of the two competing
# predictions for the theta that lands the steady-state slab T_e on 470
# eV. H3_470eV_eheat's amplitude was calibrated for the ION target and
# gives 2945 eV on the fluid, 6.3x too hot, because the two targets lose
# heat by different channels. Everything else is byte-identical to
# H3_470eV_eheat, which supplies the second point of the fit. Not a
# physics run: its output is T_ss(theta), and the production run at the
# fitted theta tests the law.
#
# Solver: HYBRID (kinetic ions, fluid electrons)
# Derived scales (1D, lengths in d_i0 (ambient) = 24.26 um):
#   n_amb = 4.8e+24 m^-3 (REFERENCE)   ambient fill 1 n_amb   piston 250 n_amb
#   m_i/m_e = 100   Z = 1
#   d_i0 = 24.26 um (10 d_e0)   dz = 0.6064 um = 0.025 d_i0
#   dt = 5.0574e-14 s = 0.000625/wci0   8960 steps = 5.6/wci0 = 453.1 ps
#   n_cell = 3200
#   CLOSURE P_e = n0_ref kT_e0 (n/n0_ref)^gamma   =>   T_e(n) = T_e0 (n/n0_ref)^(gamma-1)
#     gamma = 1.66667 (adiabatic), n0_ref = 1 n_amb, T_e0 = 10 eV
#     T_e = 10 eV (ambient) -> 396.85 eV (piston): contrast 39.69x
#     C_s = 0.0004424 c (ambient) -> 0.002787 c (piston)
#   GATE GH1 dt*wci0 = 0.000625, particle CFL = 0.26 at v_max = 0.0104 c
#   GATE GH2 substeps = 38 vs a bare whistler requirement of 3.489  (grows as dz^-2)
#   GATE GH3 dz/d_i: ambient 0.025, PISTON 0.3953
#   GATE GH4 n_floor = 0.01 n_amb (Ohm's law carries 1/(e n_e))
#   B0 = 7.026 T   v_A = 0.0009999 c   1/wci0 = 80.92 ps   rho_i0 = 10.4 d_i0
#   M_A = 10.400  M_ms = 9.511  beta_e0 = 0.391
# ==========================================================================

# --- reference: the AMBIENT ion scales are this run's unit system ---
my_constants.namb   = 4.8e24
my_constants.mass_ratio = 100.
my_constants.Mi     = mass_ratio*m_e
my_constants.Zi     = 1.
my_constants.wpi    = sqrt(namb*(Zi*q_e)^2/(epsilon0*Mi))
my_constants.di     = clight/wpi          # d_i0 = 24.26 um

# --- densities (in n_amb) ---
my_constants.npist  = 250.*namb
my_constants.nfill  = 1.*namb

# --- piston geometry (a slab of half-width wp about zp) ---
my_constants.zp     = 0.*di
my_constants.wp     = 2.*di

# --- ion temperatures (ION-normalized: u_std = sqrt(theta_i) in units of c) ---
my_constants.th_pi  = 1.95695118e-07
my_constants.th_ai  = 1.95695118e-07

# --- background field (perpendicular: B0 transverse to the shock normal z, along x) ---
my_constants.vA     = 0.000999873*clight
my_constants.B0     = vA*sqrt(mu0*namb*Mi)      # 7.026 T

# --- domain ---
my_constants.zlo = 0.*di
my_constants.zhi = 80.*di

# ------------------------------------------------------------------------
# --- THE SOLVER: Ampere + Ohm's law (kinetic ions, fluid electrons) ---
#
#   mu0 J = curl B            (no displacement current: light is stepped over)
#   J_e   = J - sum_s J_s     (electron current BY SUBTRACTION -- so an
#                              electron SPECIES would be counted as an ion)
#   E     = -(J_e x B + grad P_e)/(e n_e) + eta J - eta_h laplacian J
#   dB/dt = -curl E           (RK4, sub-stepped `substeps` times per half step)
#
# warpx.const_dt is MANDATORY here (WarpXComputeDt.cpp:55) and there is no CFL
# to fall back on: NOTHING in WarpX checks this timestep. Gate GH1 does.
# ------------------------------------------------------------------------
algo.maxwell_solver = hybrid
warpx.const_dt      = 5.057350186696479e-14      # 0.000625/wci0, particle CFL 0.26
max_step            = 8960      # 5.6/wci0
warpx.verbose       = 1
warpx.grid_type     = collocated  # solver best practice
algo.particle_shape = 1          # linear: Stanier et al. 2020

# --- the electron fluid ---
#
# THE ENTIRE ELECTRON PHYSICS IS THIS CLOSURE. There is no electron
# temperature FIELD and no energy equation, so nothing can heat the electrons
# (HYBRID_PLAN.md §8). T_e is slaved to n_e:
#     P_e = n0_ref kT_e0 (n_e/n0_ref)^gamma  =>  T_e = T_e0 (n/n0_ref)^(gamma-1)
# gamma = 1 is the infinite-conduction limit, 5/3 the zero-conduction limit;
# the pair BRACKETS a problem that really needs heat transport (HB6).
my_constants.Te0    = 9.999999981737545        # eV (theta = 1.95695e-05)
my_constants.n0ref  = 1.*namb
my_constants.nfloor = 0.01*namb
hybrid_pic_model.elec_temp = Te0          # eV -- NOT theta
hybrid_pic_model.n0_ref    = n0ref
hybrid_pic_model.gamma     = 1.6666666666666667
hybrid_pic_model.n_floor   = nfloor       # Ohm's law carries 1/(e n_e)
hybrid_pic_model.substeps  = 38           # GH2: bare whistler requirement 3.49
hybrid_pic_model.holmstrom_vacuum_region = 1
hybrid_pic_model.plasma_resistivity(rho,J,t) = "3.9938e-11"   # Ohm m -- this is the ONLY electron-ion drag in the model

# --- electron energy equation (HYBRID_PLAN.md §8) --
# Needs the warpx-cda fork, branch feature/particle-heater.
hybrid_pic_model.electron_energy_mode = advected
hybrid_pic_model.electron_temp_init = polytropic   # seed T_e with the closure's profile so t=0 matches a mode=none twin

# --- grid (dz = 0.025 d_i0; z = shock normal) ---
amr.n_cell        = 3200
amr.max_level     = 0      # the hybrid solver aborts for lev > 0 (no AMR)
amr.blocking_factor = 8
geometry.dims     = 1
geometry.prob_lo  = zlo
geometry.prob_hi  = zhi

# boundaries: z symmetry/open
#   INHERITED FROM THE EXPLICIT PROJECTS AND UNTESTED HERE: 'open' = pec
#   fields + absorbing particles was chosen for a solver that does not evolve
#   B from Ohm's law. Phase H0 (H0_bc) is the test. Until then this is a
#   declared assumption, not a result.
boundary.field_lo    = pec
boundary.field_hi    = pec
boundary.particle_lo = reflecting
boundary.particle_hi = absorbing
warpx.random_seed    = 1

# --- background field (perpendicular) ---
# B0 must be an INITIAL GRID field, not a gather-only applied field: in hybrid
# it is evolved by Faraday and it is curl B that supplies the total current.
warpx.Bx_external_grid_function(x,y,z) = "B0"
warpx.By_external_grid_function(x,y,z) = "0."
warpx.Bz_external_grid_function(x,y,z) = "0."
warpx.B_ext_grid_init_style       = parse_B_ext_grid_function

# --- species ---
# IONS ONLY. The electrons are the fluid above; there is no electron species
# to declare, and declaring one would be counted as an ion (gate GH8).
particles.species_names = piston_ions amb_ions

# --- piston ions ---
piston_ions.charge = q_e
piston_ions.mass   = Mi
piston_ions.injection_style = "NUniformPerCell"
piston_ions.num_particles_per_cell_each_dim = 3200
piston_ions.profile = parse_density_function
piston_ions.density_function(x,y,z) = "npist*((z>=zp-wp)*(z<=zp+wp))"
piston_ions.density_min = 1.e-4*namb
piston_ions.momentum_distribution_type = maxwellian
piston_ions.maxwellian_u_std_distribution_type = "constant"
piston_ions.ux_std = sqrt(th_pi)
piston_ions.uy_std = sqrt(th_pi)
piston_ions.uz_std = sqrt(th_pi)

# --- ambient ions ---
amb_ions.charge = q_e
amb_ions.mass   = Mi
amb_ions.injection_style = "NUniformPerCell"
amb_ions.num_particles_per_cell_each_dim = 1600
amb_ions.profile = parse_density_function
amb_ions.density_function(x,y,z) = "nfill*((z<zp-wp)+(z>zp+wp))"
amb_ions.density_min = 1.e-4*namb
amb_ions.momentum_distribution_type = maxwellian
amb_ions.maxwellian_u_std_distribution_type = "constant"
amb_ions.ux_std = sqrt(th_ai)
amb_ions.uy_std = sqrt(th_ai)
amb_ions.uz_std = sqrt(th_ai)

# ------------------------------------------------------------------------
# --- STOCHASTIC HEATER (PSC flatfoil port; cross-validated operator-for-
#     operator in warpx-cda/heating_operator/) ---
#
# The kernel adds du_i = sqrt(H dt) N(0,1) to each momentum COMPONENT, where u
# is momentum/mass -- so it is a VELOCITY-space diffusion, d<v_i^2>/dt = H,
# IDENTICAL FOR ANY SPECIES MASS, and the energy input rate is (3/2) m_s H.
# ------------------------------------------------------------------------
# The fluid source is S = (3/2) n_e m_e H [W/m^3], the exact inverse of what
# LaserDeposition does when it forms H = P_abs/(n_e m_e). Needs the
# warpx-cda fork, branch feature/particle-heater, and
# hybrid_pic_model.electron_energy_mode != none.
particle_heater.target = electron_fluid
particle_heater.species   = piston_ions
particle_heater.intervals = 5
particle_heater.profile   = parser
my_constants.Hheat = 6.251238548236967e23   # m^2/s^3; theta_e_equiv 0.000199307  [ELECTRON-normalized: the fluid receives (3/2) n m_e H]
particle_heater.piston_ions.heating_rate_function(x,y,z,t) = "(z>zp-wp)*(z<zp+wp)*Hheat"

# --- DENSITY-RELAXATION TARGET INJECTOR (PSC InjectFoil port) ---
# No neutralizing species: there are no electrons to co-inject, and charge
# balance is automatic under quasineutrality (it is optional upstream).
target_injector.species        = piston_ions
target_injector.density        = npist
target_injector.reference_density = npist   # the PISTON's, so injected weight == loaded weight
target_injector.ppc_reference  = 800   # NOT the piston's 3200: two weights
target_injector.tau            = 3.2367041194857467e-12   # 0.04/wci0
target_injector.intervals      = 5
target_injector.lo             = zp-wp
target_injector.hi             = zp+wp
target_injector.piston_ions.u_std = 0.00044237440929601704   # sqrt(theta_i) = sqrt(1.95695e-07), ion-normalized, in units of c

# --- diagnostics ---
# GATE GH6 needs the fluid's internal energy too, and there is no reduced diag for
# it: hybrid_report.py reconstructs (3/2) n k_B T_e from rho and the closure.
# eta*J^2 dissipation leaves the system entirely (HYBRID_PLAN.md §8).
warpx.reduced_diags_names = EP FE PN
EP.type      = ParticleEnergy
EP.intervals = 40
FE.type      = FieldEnergy
FE.intervals = 40
PN.type      = ParticleNumber
PN.intervals = 40

diagnostics.diags_names = diag1 diag_fields diag_phase

# diag1: fields + all particles (~7 frames)
diag1.intervals = 0:960:20, 1200:1200, 1600:1600, 2400:2400, 3200:3200, 4800:4800, 6400:6400, 8960:8960
diag1.diag_type = Full

# diag_fields: field-only, high cadence (~101 frames).
# rho is the WHOLE electron diagnostic in hybrid: n_e = rho/(Z e) exactly.
# Te [eV] and Pe [Pa] are SOLVED here, not derived from rho -- dump them, and
# do NOT reconstruct T_e from the closure for this run.
diag_fields.intervals     = 88
diag_fields.diag_type     = Full
diag_fields.write_species = 0
diag_fields.fields_to_plot = Ez Ey By Bx jz rho rho_piston_ions rho_amb_ions Te Pe

# diag_phase: particles only, subsampled -- PHASE SPACE IS THE ARBITER of a
# shock claim, and reflected ambient ions (criterion 6) are the one kinetic
# signature the hybrid reduction fully retains.
diag_phase.intervals     = 88
diag_phase.diag_type     = Full
diag_phase.fields_to_plot = none
diag_phase.species       = piston_ions amb_ions
diag_phase.piston_ions.random_fraction = 0.2
diag_phase.amb_ions.random_fraction = 0.2
