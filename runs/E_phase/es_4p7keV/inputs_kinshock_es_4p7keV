col_pe_pe.type       = pairwisecoulomb
col_pe_pe.species    = piston_electrons piston_electrons
col_pe_pe.CoulombLog = coulomb_log
col_pe_pe.ndt_supercycle = 10
col_pe_pi.type       = pairwisecoulomb
