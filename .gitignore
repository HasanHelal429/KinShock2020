# --- WarpX simulation output (large, machine-specific, regenerable from the decks) ---
runs/**/diags/
runs/**/diags_movies/
runs/**/diags_movie/

# --- studies scratch (WarpX variant runs, regenerable from the runner) ---
studies/**/scratch/
# benchmark points written by studies/speedup/bench.sh (run.log + plotfiles).
# The findings live in runs/opt_phase/SUMMARY.md and RESULTS.md, not here.
studies/**/out/
studies/**/*.out

# --- any media ---
media/

# --- run logs (large with verbose=1; findings are recorded in RESULTS.md) ---
*.log

# --- generated / transient ---
runs/**/config.generated.yaml
# binned phase spaces memoised by make_thomson.py (~10 MB/run, re-read from diags/)
runs/**/thomson_cache/
**/__pycache__/
*.py[cod]
*.egg-info/
.ipynb_checkpoints/

# --- the paper PDF: copyrighted (AIP / DOE accepted manuscript), not for redistribution ---
# Get it from doi:10.1063/1.5123229 or OSTI 1643946. See README.
schaeffer2020.pdf

# --- OS / editor cruft ---
.DS_Store
*.swp

# AMReX backtrace dumps
Backtrace.*

# --- job scratch (regen logs, ad-hoc; keepers live in scripts/) ---
tmp/

# --- progress-logger stdout (the findings live in progress.log / RESULTS.md) ---
runs/**/*.out

# Perlmutter site-specific settings (account code, scratch paths)
perlmutter/site.conf
perlmutter/.runlists/
